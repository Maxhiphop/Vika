      "Ты — моя сила.",
      "Ты — мой смысл в хаосе.",
      "Ты — моё лучшее .",
      "Ты — мой ежедневный выбор.",
      "Ты — моя тихая радость.",
      "Ты — мой ежедневный повод сказать Я ТЕБЯ ЛЮБЛЮ.",
      "Ты — моя навсегда."
    ];

    // Создание пузырька
    function addBubble() {
      const index = Math.floor(Math.random() * texts.length);
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      const x = Math.random() * 80;
      const y = Math.random() * 80;
      const tx = (Math.random() * 20 - 10) + 'vw';
      const ty = (Math.random() * 20 - 10) + 'vh';

      bubble.style.top = x + 'vh';
      bubble.style.left = y + 'vw';
      bubble.style.setProperty('--tx', tx);
      bubble.style.setProperty('--ty', ty);
      bubble.style.animationDuration = (12 + Math.random() * 15) + 's';

      bubble.innerHTML = '♡';
      bubble.onclick = () => {
        bubble.innerHTML = texts[index];
        bubble.style.color = '#000';
      };

      document.body.appendChild(bubble);
    }

    // Лепестки сакуры
    function createSakura() {
      const sakura = document.createElement('div');
      sakura.className = 'sakura';
      sakura.innerHTML = '🌸';
      sakura.style.left = Math.random() * 100 + 'vw';
      sakura.style.animationDuration = (5 + Math.random() * 5) + 's';
      document.body.appendChild(sakura);

      setTimeout(() => sakura.remove(), 10000);
    }
    setInterval(createSakura, 500);

    // Салют сердечек
    function surprise() {
      for (let i = 0; i < 20; i++) {
        const heart = document.createElement('div');
        heart.className = 'heart';
        heart.innerHTML = '❤️';
        heart.style.left = '50%';
        heart.style.top = '50%';
        const angle = Math.random() * 2 * Math.PI;
        const distance = Math.random() * 200;
        const x = Math.cos(angle) * distance + 'px';
        const y = Math.sin(angle) * distance + 'px';
        heart.style.setProperty('--x', x);
        heart.style.setProperty('--y', y);
        document.body.appendChild(heart);

        setTimeout(() => heart.remove(), 1500);
      }
    }
  </script>
</body>
</html>
