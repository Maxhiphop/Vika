<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Вика — моя любовь</title>
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Roboto:wght@300;500&display=swap" rel="stylesheet">
  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      font-family: 'Roboto', sans-serif;
      background: linear-gradient(135deg, #ff99cc, #ffe6f0);
      color: #ffe6f0;
      overflow-x: hidden;
    }

    header, .button-container, main, footer {
      position: relative;
      z-index: 1;
    }

    header {
      background: linear-gradient(135deg, #ff66b3, #cc0066);
      padding: 70px 20px;
      text-align: center;
      border-bottom-left-radius: 50px;
      border-bottom-right-radius: 50px;
      box-shadow: 0 12px 40px rgba(255, 102, 179, 0.5);
    }

    header h1 {
      font-family: 'Pacifico', cursive;
      font-size: 2.6em;
      color: #fff;
      margin: 0;
      text-shadow: 2px 2px 8px rgba(0,0,0,0.2);
      animation: fadeIn 2s ease-in-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Контейнер с кнопками */
    .button-container {
      position: fixed;
      top: 15px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
    }

    .button-container button {
      background: linear-gradient(135deg, #ff66a3, #ff3385);
      border: none;
      color: white;
      padding: 12px 22px;
      font-size: 1em;
      border-radius: 35px;
      cursor: pointer;
      box-shadow: 0 6px 15px rgba(255, 102, 163, 0.5);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      margin: 5px;
      flex: 1 1 auto;
      min-width: 130px;
      text-align: center;
    }

    .button-container button:hover {
      transform: scale(1.05);
      box-shadow: 0 8px 20px rgba(255, 51, 133, 0.6);
    }

    .bubble {
      position: absolute;
      width: 100px;
      height: 100px;
      background: rgba(255, 255, 255, 0.6);
      border: 3px solid #ff99cc;
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #000;
      text-align: center;
      font-size: 0.9em;
      padding: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      animation: moveBubble linear infinite alternate;
      font-weight: 400;
      backdrop-filter: blur(6px);
      box-shadow: 0 0 15px rgba(255, 153, 204, 0.6);
      z-index: 2;
    }

    .bubble:hover {
      background-color: rgba(255, 255, 255, 0.85);
      transform: scale(1.1) rotate(3deg);
      box-shadow: 0 0 20px #ff80bf;
    }

    @keyframes moveBubble {
      0%   { transform: translate(0, 0); }
      100% { transform: translate(var(--tx), var(--ty)); }
    }

    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    footer {
      text-align: center;
      padding: 30px 20px;
      background: linear-gradient(135deg, #660033, #4d0033);
      color: #ffb3d9;
      font-size: 1.1em;
      border-top-left-radius: 40px;
      border-top-right-radius: 40px;
      box-shadow: 0 -8px 25px rgba(255, 128, 191, 0.3);
    }

    /* Лепестки сакуры */
    .sakura {
      position: fixed;
      top: -10px;
      font-size: 24px;
      animation: fall linear infinite;
      z-index: 0;
      pointer-events: none;
    }
    @keyframes fall {
      0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
      100% { transform: translateY(100vh) rotate(360deg); opacity: 0.3; }
    }

    /* Салют сердечек */
    .heart {
      position: fixed;
      font-size: 24px;
      color: red;
      animation: explode 1.5s ease-out forwards;
      pointer-events: none;
      z-index: 10;
    }
    @keyframes explode {
      0% { transform: scale(0.5) translate(0,0); opacity: 1; }
      100% { transform: scale(1.5) translate(var(--x), var(--y)); opacity: 0; }
    }

    @media screen and (max-width: 480px) {
      .bubble {
        width: 75px;
        height: 75px;
        font-size: 0.8em;
      }
      header h1 {
        font-size: 2em;
      }
      .button-container button {
        font-size: 0.9em;
        padding: 10px 18px;
      }
    }
  </style>
</head>
<body>
  <div class="button-container">
    <button onclick="addBubble()">Добавить сердечко</button>
    <button onclick="surprise()">🎁 Сюрприз</button>
  </div>

  <header>
    <h1>Вика — свет моего сердца 💖</h1>
  </header>

  <main></main>

